# =============================================================================
# Gainode V2.0 后端环境变量契约（.env.example）
# -----------------------------------------------------------------------------
# 规则（07 §S02-P01 固定步骤 6）：
#   - 本文件只写变量名、安全关闭值（空值 / false / 占位）和说明。
#   - 禁止写入任何真实 secret、生产 URL、正式参数、真实密钥。
#   - 生产配置不在本文件创建；真实值在部署时由运维注入，缺失即 fail-closed。
# =============================================================================

# ---- 应用基础 ----
APP_LISTEN=http://0.0.0.0:8787
APP_DOMAIN=http://127.0.0.1:8787
APP_PROCESS=4
APP_REDIS_PROCESS=4
APP_MAX_REQUEST=1000000
APP_ENV=test                 # test | staging | production
APP_DEBUG=false              # 生产必须 false
APP_PROCESS_LIST=crontab_task

# ---- 安全 / 签名（V2.0：旧 MD5 签名密钥迁移到此，缺失 fail-closed）----
SIGN_PRIVATE_KEY=             # 旧 MD5 签名共享密钥（V1.x 遗留，V2.0 不再校验；留空安全关闭）
PWD_SECRET_KEY=               # 密码哈希盐/密钥（缺失 fail-closed）
JWT_SECRET=                   # JWT 签名密钥（firebase/php-jwt，缺失 fail-closed，禁止硬编码）
APP_KEY=                      # 应用加密主密钥（对称加密/签名，缺失 fail-closed）

# ---- 数据库 ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=webman
MYSQL_USER=root
MYSQL_PASS=                   # 禁止提交真实密码
MYSQL_CHARSET=utf8mb4

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=                   # 禁止提交真实密码
REDIS_QUEUE=redis://127.0.0.1:6379

# ---- 邮件 ----
MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=                # 禁止提交真实密码
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Gainode

# ---- 对象存储 / 上传（V2.0 预签名 URL，AK/SK 移到此处，缺失 fail-closed）----
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PRESIGNED_EXPIRE=900

# ---- API 内核开关 ----
API_ENFORCE_IDEMPOTENCY=true  # 写操作强制 Idempotency-Key（V2.0 fail-closed）
API_BASE_URL=/api/v1
