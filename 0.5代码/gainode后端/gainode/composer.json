{
  "name": "workerman/webman",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "workerman/webman-framework": "~2.1",
    "webman/redis": "~2.1",
    "webman/database": "~2.1",
    "webman/cache": "~2.1",
    "webman/log": "~2.1",
    "webman/channel": "^2.1",
    "webman/console": "^2.1",
    "webman/redis-queue": "^1.3",
    "workerman/crontab": "^1.0",
    "webman/push": "^1.1",
    "webman/event": "^1.0",
    "webman/rate-limiter": "^1.1",
    "illuminate/validation": "~10.48",
    "illuminate/pagination": "~10.48",
    "illuminate/events": "~10.48",
    "yansongda/pay": "~3.3.0",
    "monolog/monolog": "^2.10",
    "casbin/casbin": "^3.21",
    "ramsey/uuid": "^4.7",
    "vlucas/phpdotenv": "^5.6",
    "swiftmailer/swiftmailer": "^6.3",
    "firebase/php-jwt": "^6.10",
    "godruoyi/php-snowflake": "^2.2",
    "tuupola/base62": "^2.1",
    "zjkal/time-helper": "^1.1",
    "google/cloud-translate": "^1.17",
    "phpoffice/phpspreadsheet": "^4.0",
    "chillerlan/php-qrcode": "^5.0",
    "botman/botman": "^2.8",
    "web3p/web3.php": "^0.3.2",
    "web3p/ethereum-tx": "^0.4.3",
    "pragmarx/google2fa": "^9.0",
    "bacon/bacon-qr-code": "^3.0",
    "longman/telegram-bot": "^0.83.1",
    "shopwwi/webman-socialite": "^1.0",
    "twig/twig": "~3.4.0",
    "zoujingli/ip2region":"^3.0",
    "cweagans/composer-patches": "^1.7"
  },
  "autoload": {
    "psr-4": {
      "": "./",
      "app\\": "./app",
      "App\\": "./app",
      "app\\View\\Components\\": "./app/view/components"
    },
    "files": [
      "./support/helpers.php"
    ]
  },
  "scripts": {
    "post-package-install": [
      "support\\Plugin::install"
    ],
    "post-package-update": [
      "support\\Plugin::install"
    ],
    "pre-package-uninstall": [
      "support\\Plugin::uninstall"
    ],
    "test": "php tests/ledger/LedgerAppendOnlyMutationMatrixTest.php"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "cweagans/composer-patches": true
    }
  },
  "extra": {
    "patches": {
      "simplito/bn-php": {
        "Fix deprecated assert_options()/ASSERT_ACTIVE on PHP 8.3+": "patches/bn-php-assert.patch"
      }
    }
  }
}
